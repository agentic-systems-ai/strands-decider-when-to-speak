 "turns": [
  {
   "index": 0,
   "speaker": "Chidi",
   "text": "Good afternoon. Let's start with the census. Lars, where are we with the plan?",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E001"
   ],
   "interrupted": false
  },
  {
   "index": 1,
   "speaker": "Lars",
   "text": "We'll re-census all the permanent plots this summer. That's about forty plots.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E002"
   ],
   "interrupted": false
  },
  {
   "index": 2,
   "speaker": "Pat",
   "text": "Forty-eight, I think. The eight we added along the creek count too.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E003"
   ],
   "interrupted": false
  },
  {
   "index": 3,
   "speaker": "Lars",
   "text": "Right, forty-eight with the creek plots. Thanks, Pat.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E004"
   ],
   "interrupted": false
  },
  {
   "index": 4,
   "speaker": "Chidi",
   "text": "And how many trees is that in total?",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E005"
   ],
   "interrupted": false
  },
  {
   "index": 5,
   "speaker": "Pat",
   "text": "Sixty-three hundred tagged trees. Some tags will be gone, of course.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E006"
   ],
   "interrupted": false
  },
  {
   "index": 6,
   "speaker": "Mariana",
   "text": "When was the last full census?",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E007"
   ],
   "interrupted": false
  },
  {
   "index": 7,
   "speaker": "Chidi",
   "text": "Five years ago. It's on a five-year cycle.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E008"
   ],
   "interrupted": false
  },
  {
   "index": 8,
   "speaker": "Lars",
   "text": "Seedling mortality has been high since then. Roughly half the seedlings died, from the plots I've checked.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E009"
   ],
   "interrupted": false
  },
  {
   "index": 9,
   "speaker": "Chidi",
   "text": "That would be a lot. Let's see what the full census says.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 10,
   "speaker": "Pat",
   "text": "The truck is the other question. We've got a three thousand mile budget for the season.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E010"
   ],
   "interrupted": false
  },
  {
   "index": 11,
   "speaker": "Lars",
   "text": "Forty-eight plots over that many miles should be fine if we group them by area.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E011"
   ],
   "interrupted": false
  },
  {
   "index": 12,
   "speaker": "Pat",
   "text": "I'll plan the route so we visit the plots by area, two days per cluster.",
   "agenda_item": "census",
   "direction": null,
   "event_ids": [
    "E012"
   ],
   "interrupted": false
  },
  {
   "index": 13,
   "speaker": "Chidi",
   "text": "The drone survey. Lars?",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E013"
   ],
   "interrupted": false
  },
  {
   "index": 14,
   "speaker": "Lars",
   "text": "We've done twenty-one flights with the regular camera. For the canopy structure, we need the LiDAR sensor.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E014"
   ],
   "interrupted": false
  },
  {
   "index": 15,
   "speaker": "Chidi",
   "text": "What does the rental cost?",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E015"
   ],
   "interrupted": false
  },
  {
   "index": 16,
   "speaker": "Lars",
   "text": "Twenty-four hundred a week. I'd like two weeks.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E016"
   ],
   "interrupted": false
  },
  {
   "index": 17,
   "speaker": "Pat",
   "text": "The batteries are the limit. We have six that hold a charge.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E017"
   ],
   "interrupted": false
  },
  {
   "index": 18,
   "speaker": "Lars",
   "text": "Six is enough for about two flights a day.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E018"
   ],
   "interrupted": false
  },
  {
   "index": 19,
   "speaker": "Chidi",
   "text": "Is one week enough if we plan the flights carefully?",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E019",
    "E020"
   ],
   "interrupted": false
  },
  {
   "index": 20,
   "speaker": "Lars",
   "text": "One week is enough for the core plots. Two would cover the creek plots as well.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 21,
   "speaker": "Chidi",
   "text": "Then let's rent it for one week, and we'll consider a second week if the weather is kind.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E021"
   ],
   "interrupted": false
  },
  {
   "index": 22,
   "speaker": "Pat",
   "text": "Who's actually certified to fly with the LiDAR payload?",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E022"
   ],
   "interrupted": false
  },
  {
   "index": 23,
   "speaker": "Lars",
   "text": "That works. I'll book the sensor for the first week of June.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E023"
   ],
   "interrupted": false
  },
  {
   "index": 24,
   "speaker": "Mariana",
   "text": "Is the conference hotel booked for July, by the way? I saw prices going up.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [
    "E024",
    "E025"
   ],
   "interrupted": false
  },
  {
   "index": 25,
   "speaker": "Pat",
   "text": "I booked it last month. You're sharing with the student from Oregon.",
   "agenda_item": "drones",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 26,
   "speaker": "Chidi",
   "text": "Good. Let's talk about student progress. Mariana, how's the thesis going?",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E026"
   ],
   "interrupted": false
  },
  {
   "index": 27,
   "speaker": "Mariana",
   "text": "It's going. I have two of the four chapters drafted.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E027"
   ],
   "interrupted": false
  },
  {
   "index": 28,
   "speaker": "Chidi",
   "text": "And the defense is on May ninth.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E028"
   ],
   "interrupted": false
  },
  {
   "index": 29,
   "speaker": "Mariana",
   "text": "Yes. May ninth.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E029"
   ],
   "interrupted": false
  },
  {
   "index": 30,
   "speaker": "Lars",
   "text": "Two chapters with about ten weeks to go. That's doable, but tight.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E030"
   ],
   "interrupted": false
  },
  {
   "index": 31,
   "speaker": "Chidi",
   "text": "Which chapters are left?",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E031"
   ],
   "interrupted": false
  },
  {
   "index": 32,
   "speaker": "Mariana",
   "text": "The seedling chapter and the discussion. The seedling data shows about fifty percent mortality, so it's a big story.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E032"
   ],
   "interrupted": false
  },
  {
   "index": 33,
   "speaker": "Pat",
   "text": "Sorry, I just checked the summary sheet. It's thirty-one percent, not fifty.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E033"
   ],
   "interrupted": false
  },
  {
   "index": 34,
   "speaker": "Lars",
   "text": "That was my number earlier. I only had the north plots in mind.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 35,
   "speaker": "Mariana",
   "text": "Thirty-one. Still a story, just a smaller one.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E034"
   ],
   "interrupted": false
  },
  {
   "index": 36,
   "speaker": "Chidi",
   "text": "Could we meet weekly until the defense, just for half an hour?",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E035"
   ],
   "interrupted": false
  },
  {
   "index": 37,
   "speaker": "Mariana",
   "text": "Yes, please. That would help me keep moving.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 38,
   "speaker": "Chidi",
   "text": "Then weekly meetings on Tuesdays until May.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E036"
   ],
   "interrupted": false
  },
  {
   "index": 39,
   "speaker": "Mariana",
   "text": "I'll send you the seedling chapter outline before next Tuesday.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E037"
   ],
   "interrupted": false
  },
  {
   "index": 40,
   "speaker": "Lars",
   "text": "It might help if someone read the methods chapter with fresh eyes.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E038"
   ],
   "interrupted": false
  },
  {
   "index": 41,
   "speaker": "Pat",
   "text": "Excuse me, the delivery driver is here with the soil cores. One moment.",
   "agenda_item": "students",
   "direction": null,
   "event_ids": [
    "E039"
   ],
   "interrupted": false
  },
  {
   "index": 42,
   "speaker": "Chidi",
   "text": "Outreach day. Pat, you've been organizing it.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 43,
   "speaker": "Pat",
   "text": "It's on April eighteenth. Ninety students are coming from Cedar Middle School.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [
    "E040",
    "E041"
   ],
   "interrupted": false
  },
  {
   "index": 44,
   "speaker": "Lars",
   "text": "Ninety is a lot of twelve-year-olds in one forest.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [
    "E042"
   ],
   "interrupted": false
  },
  {
   "index": 45,
   "speaker": "Pat",
   "text": "It is. I'd like help. Last year I ran it on my own.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 46,
   "speaker": "Chidi",
   "text": "That's not fair on you. Who can help on the day?",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [
    "E043"
   ],
   "interrupted": false
  },
  {
   "index": 47,
   "speaker": "Mariana",
   "text": "I can come in the morning, before my writing day.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [
    "E044"
   ],
   "interrupted": false
  },
  {
   "index": 48,
   "speaker": "Lars",
   "text": "I'll take the afternoon group and do the tree measuring station.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [
    "E045"
   ],
   "interrupted": false
  },
  {
   "index": 49,
   "speaker": "Pat",
   "text": "Thank you both. That makes a real difference.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 50,
   "speaker": "Mariana",
   "text": "Do we have enough hand lenses for that many students?",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [
    "E046"
   ],
   "interrupted": false
  },
  {
   "index": 51,
   "speaker": "Chidi",
   "text": "What happens if it rains?",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [
    "E047"
   ],
   "interrupted": false
  },
  {
   "index": 52,
   "speaker": "Pat",
   "text": "We move into the teaching lab and do the leaf pressing station instead.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 53,
   "speaker": "Chidi",
   "text": "I think that's everything. Thank you, all. Good week, everyone.",
   "agenda_item": "outreach",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  }
 ],
