 "turns": [
  {
   "index": 0,
   "speaker": "Galina",
   "text": "Hello, everyone. Can you all see me? Rob, your camera's pointing at the ceiling.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 1,
   "speaker": "Rob",
   "text": "Sorry. Better?",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 2,
   "speaker": "Galina",
   "text": "Much better. Katya, let's start with the day itself.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 3,
   "speaker": "Katya",
   "text": "The garden venue is confirmed for June fourteenth, ceremony at three.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [
    "E001",
    "E002"
   ],
   "interrupted": false
  },
  {
   "index": 4,
   "speaker": "Misha",
   "text": "Three is perfect for photos. The light in that garden in the afternoon is beautiful.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [
    "E003"
   ],
   "interrupted": false
  },
  {
   "index": 5,
   "speaker": "Galina",
   "text": "And if it rains?",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [
    "E004"
   ],
   "interrupted": false
  },
  {
   "index": 6,
   "speaker": "Katya",
   "text": "The venue has a tent we can rent. Nine hundred dollars.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [
    "E005"
   ],
   "interrupted": false
  },
  {
   "index": 7,
   "speaker": "Rob",
   "text": "Nine hundred for a tent. Well, it's cheaper than ruined dresses.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [
    "E006"
   ],
   "interrupted": false
  },
  {
   "index": 8,
   "speaker": "Galina",
   "text": "Do we have to decide about the tent now?",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [
    "E007"
   ],
   "interrupted": false
  },
  {
   "index": 9,
   "speaker": "Katya",
   "text": "By the end of May. They need a week's notice.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 10,
   "speaker": "Rob",
   "text": "Let's book it anyway. I'd rather not watch the forecast all week.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [
    "E008"
   ],
   "interrupted": false
  },
  {
   "index": 11,
   "speaker": "Katya",
   "text": "Thank you, Dad. I'll tell the venue on Monday.",
   "agenda_item": "venue_day",
   "direction": null,
   "event_ids": [
    "E009"
   ],
   "interrupted": false
  },
  {
   "index": 12,
   "speaker": "Galina",
   "text": "Guests. We're at about eighty confirmed, I think.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [
    "E010"
   ],
   "interrupted": false
  },
  {
   "index": 13,
   "speaker": "Katya",
   "text": "That's close to the garden's limit. It holds ninety.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [
    "E011"
   ],
   "interrupted": false
  },
  {
   "index": 14,
   "speaker": "Galina",
   "text": "I have a few more names, actually. Your grandfather's cousins in Riga.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 15,
   "speaker": "Katya",
   "text": "Auntie. I've never met them.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 16,
   "speaker": "Galina",
   "text": "They knew you when you were a baby.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 17,
   "speaker": "Rob",
   "text": "The RSVP deadline is the first of May. Anyone who hasn't replied by then isn't coming.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [
    "E012"
   ],
   "interrupted": false
  },
  {
   "index": 18,
   "speaker": "Galina",
   "text": "That seems harsh for family.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 19,
   "speaker": "Rob",
   "text": "Maybe we invite the Riga cousins anyway and see who comes?",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [
    "E013",
    "E014"
   ],
   "interrupted": false
  },
  {
   "index": 20,
   "speaker": "Katya",
   "text": "It's not harsh. It's a garden with ninety chairs.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [
    "E015"
   ],
   "interrupted": false
  },
  {
   "index": 21,
   "speaker": "Galina",
   "text": "All right. I'll send the Riga cousins a card, but no invitation.",
   "agenda_item": "guests",
   "direction": null,
   "event_ids": [
    "E016"
   ],
   "interrupted": false
  },
  {
   "index": 22,
   "speaker": "Katya",
   "text": "Food. The caterer is fifty-five a head, buffet style.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E017"
   ],
   "interrupted": false
  },
  {
   "index": 23,
   "speaker": "Misha",
   "text": "Buffets are great for photos. People actually talk to each other.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 24,
   "speaker": "Galina",
   "text": "And the cake?",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E018"
   ],
   "interrupted": false
  },
  {
   "index": 25,
   "speaker": "Katya",
   "text": "Two tiers. Lemon on the bottom, chocolate on top.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E019"
   ],
   "interrupted": false
  },
  {
   "index": 26,
   "speaker": "Rob",
   "text": "The band is booked. A thousand dollars for the whole evening.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E020"
   ],
   "interrupted": false
  },
  {
   "index": 27,
   "speaker": "Katya",
   "text": "Dad, the contract you forwarded says fourteen hundred.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E021"
   ],
   "interrupted": false
  },
  {
   "index": 28,
   "speaker": "Rob",
   "text": "Ah. Fourteen hundred. They added the extra hour.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E022"
   ],
   "interrupted": false
  },
  {
   "index": 29,
   "speaker": "Galina",
   "text": "That's still reasonable for a whole band.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 30,
   "speaker": "Rob",
   "text": "The neighbors should probably hear about the band before the day.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E023"
   ],
   "interrupted": false
  },
  {
   "index": 31,
   "speaker": "Misha",
   "text": "My friend's band played at my office party. They did a polka at the end and everyone joined in.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E024"
   ],
   "interrupted": false
  },
  {
   "index": 32,
   "speaker": "Galina",
   "text": "A polka! Your grandfather would have loved that.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 33,
   "speaker": "Katya",
   "text": "Who's doing the photos? We haven't booked anyone yet.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E025"
   ],
   "interrupted": false
  },
  {
   "index": 34,
   "speaker": "Rob",
   "text": "Professional photographers are expensive.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 35,
   "speaker": "Misha",
   "text": "I could do them, if you want. I'd love to.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E026"
   ],
   "interrupted": false
  },
  {
   "index": 36,
   "speaker": "Katya",
   "text": "Really? Misha, that would be amazing.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 37,
   "speaker": "Galina",
   "text": "Then Misha does the photos. That's settled.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [
    "E027"
   ],
   "interrupted": false
  },
  {
   "index": 38,
   "speaker": "Misha",
   "text": "I won't let you down.",
   "agenda_item": "food_music",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 39,
   "speaker": "Galina",
   "text": "Travel. Where is everyone sleeping?",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E028"
   ],
   "interrupted": false
  },
  {
   "index": 40,
   "speaker": "Rob",
   "text": "Nine cabins booked near the venue, a hundred and sixty a night.",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E029",
    "E030"
   ],
   "interrupted": false
  },
  {
   "index": 41,
   "speaker": "Katya",
   "text": "Is that enough for the out-of-town family?",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E031"
   ],
   "interrupted": false
  },
  {
   "index": 42,
   "speaker": "Galina",
   "text": "Nine cabins, two or three per cabin. That's most of them.",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E032"
   ],
   "interrupted": false
  },
  {
   "index": 43,
   "speaker": "Misha",
   "text": "And the shuttle has thirty seats, from the cabins to the garden.",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E033"
   ],
   "interrupted": false
  },
  {
   "index": 44,
   "speaker": "Rob",
   "text": "Thirty is plenty. Some people will drive.",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E034"
   ],
   "interrupted": false
  },
  {
   "index": 45,
   "speaker": "Katya",
   "text": "Could someone make a map for the guests, with the cabins and the garden?",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E035"
   ],
   "interrupted": false
  },
  {
   "index": 46,
   "speaker": "Misha",
   "text": "I'll make one. I'll put a little photo of the garden on it, too.",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E036"
   ],
   "interrupted": false
  },
  {
   "index": 47,
   "speaker": "Galina",
   "text": "Is anyone picking up Grandma from the airport?",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [
    "E037"
   ],
   "interrupted": false
  },
  {
   "index": 48,
   "speaker": "Katya",
   "text": "Thank you, everyone. This is going to be lovely.",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 49,
   "speaker": "Rob",
   "text": "It already is.",
   "agenda_item": "travel",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  }
 ],
