 "turns": [
  {
   "index": 0,
   "speaker": "Valerie",
   "text": "Thanks for coming, everyone. Dwayne, start us off with where we are?",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E001"
   ],
   "interrupted": false
  },
  {
   "index": 1,
   "speaker": "Dwayne",
   "text": "Balance is eighteen thousand four hundred. Annual income was thirty-six nine.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E002",
    "E003"
   ],
   "interrupted": false
  },
  {
   "index": 2,
   "speaker": "Phil",
   "text": "Hold on. I was told we're sitting on thirty grand. Where's the rest?",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E004",
    "E005"
   ],
   "interrupted": false
  },
  {
   "index": 3,
   "speaker": "Dwayne",
   "text": "There is no rest. It was never thirty.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 4,
   "speaker": "Phil",
   "text": "My neighbor said thirty.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E006"
   ],
   "interrupted": false
  },
  {
   "index": 5,
   "speaker": "Valerie",
   "text": "Your neighbor is not the treasurer, Phil.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 6,
   "speaker": "Dwayne",
   "text": "Eighteen four. I can send you every statement if you want them.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E007",
    "E008"
   ],
   "interrupted": false
  },
  {
   "index": 7,
   "speaker": "Phil",
   "text": "Yeah, I want them.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 8,
   "speaker": "Dwayne",
   "text": "Fine. You'll have them tonight.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E009"
   ],
   "interrupted": false
  },
  {
   "index": 9,
   "speaker": "Sienna",
   "text": "How many families are members now?",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E010"
   ],
   "interrupted": false
  },
  {
   "index": 10,
   "speaker": "Valerie",
   "text": "Two hundred and five, out of about eleven hundred students.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E011",
    "E012"
   ],
   "interrupted": false
  },
  {
   "index": 11,
   "speaker": "Phil",
   "text": "Two hundred families paying for eleven hundred kids. That's the real problem.",
   "agenda_item": "finances",
   "direction": null,
   "event_ids": [
    "E013",
    "E014"
   ],
   "interrupted": false
  },
  {
   "index": 12,
   "speaker": "Valerie",
   "text": "The prom. The class officers asked for six thousand to bring the ticket price down.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E015"
   ],
   "interrupted": false
  },
  {
   "index": 13,
   "speaker": "Sienna",
   "text": "Tickets are a hundred dollars right now. That's a lot for some families.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E016"
   ],
   "interrupted": false
  },
  {
   "index": 14,
   "speaker": "Phil",
   "text": "Then give them the six grand. Easy.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E017"
   ],
   "interrupted": false
  },
  {
   "index": 15,
   "speaker": "Dwayne",
   "text": "Prom costs twenty-four thousand total. The subsidy is a quarter of it.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E018"
   ],
   "interrupted": false
  },
  {
   "index": 16,
   "speaker": "Valerie",
   "text": "We have about four hundred seniors, so six thousand is fifteen dollars each.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E019",
    "E020"
   ],
   "interrupted": false
  },
  {
   "index": 17,
   "speaker": "Dwayne",
   "text": "That's a lot of money for one night.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 18,
   "speaker": "Sienna",
   "text": "It's the one night some of them will remember.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 19,
   "speaker": "Phil",
   "text": "The Tigers might make the state semifinal, did you see? First time in twenty years.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E021"
   ],
   "interrupted": false
  },
  {
   "index": 20,
   "speaker": "Dwayne",
   "text": "They lost to Eastfield last week.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 21,
   "speaker": "Phil",
   "text": "Eastfield cheats. Everyone knows it.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 22,
   "speaker": "Sienna",
   "text": "Can we please stay on prom?",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 23,
   "speaker": "Dwayne",
   "text": "What about a sliding scale instead? Free for kids on lunch assistance, full price for everyone else.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E022",
    "E023"
   ],
   "interrupted": false
  },
  {
   "index": 24,
   "speaker": "Valerie",
   "text": "That's harder to run, but it's fairer.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 25,
   "speaker": "Sienna",
   "text": "Wait, I just checked the student portal. Tickets are eighty-five, not a hundred. I had last year's price.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E024"
   ],
   "interrupted": false
  },
  {
   "index": 26,
   "speaker": "Phil",
   "text": "Eighty-five, a hundred, kids still can't afford it.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E025"
   ],
   "interrupted": false
  },
  {
   "index": 27,
   "speaker": "Valerie",
   "text": "Okay. Three thousand for a sliding scale, aimed at students on lunch assistance. That's what we'll propose.",
   "agenda_item": "prom",
   "direction": null,
   "event_ids": [
    "E026"
   ],
   "interrupted": false
  },
  {
   "index": 28,
   "speaker": "Sienna",
   "text": "The wellness program. Seventy-two hundred for a part-time counselor and the peer support training.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E027"
   ],
   "interrupted": false
  },
  {
   "index": 29,
   "speaker": "Phil",
   "text": "Isn't that the school district's job?",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E028"
   ],
   "interrupted": false
  },
  {
   "index": 30,
   "speaker": "Sienna",
   "text": "It should be. But each counselor has like six hundred kids.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E029"
   ],
   "interrupted": false
  },
  {
   "index": 31,
   "speaker": "Dwayne",
   "text": "The district number is three eighty per counselor. Still too many, but not six hundred.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E030"
   ],
   "interrupted": false
  },
  {
   "index": 32,
   "speaker": "Sienna",
   "text": "Three eighty. Okay. It's still a waitlist of weeks.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E031"
   ],
   "interrupted": false
  },
  {
   "index": 33,
   "speaker": "Phil",
   "text": "Seventy-two hundred and we can't even do grad night?",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E032"
   ],
   "interrupted": false
  },
  {
   "index": 34,
   "speaker": "Dwayne",
   "text": "Grad night is ninety-five hundred. We've never covered all of it.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E033"
   ],
   "interrupted": false
  },
  {
   "index": 35,
   "speaker": "Valerie",
   "text": "Here's what I'm hearing. Wellness matters more than one party.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 36,
   "speaker": "Phil",
   "text": "Says the woman whose kid wants a cheap prom.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 37,
   "speaker": "Valerie",
   "text": "That's not fair, Phil.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 38,
   "speaker": "Dwayne",
   "text": "It's not. Let's keep it about the budget.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 39,
   "speaker": "Sienna",
   "text": "Could the program start with just the peer support training this year? It's cheaper.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E034",
    "E035"
   ],
   "interrupted": false
  },
  {
   "index": 40,
   "speaker": "Dwayne",
   "text": "That part is about two thousand. The counselor is the expensive part.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 41,
   "speaker": "Sienna",
   "text": "Then the full program. It's seventy-two hundred and it's worth it.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E036"
   ],
   "interrupted": false
  },
  {
   "index": 42,
   "speaker": "Valerie",
   "text": "We fund the wellness program in full, and grad night gets what's left after that.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [
    "E037"
   ],
   "interrupted": false
  },
  {
   "index": 43,
   "speaker": "Phil",
   "text": "Grad night gets nothing, then.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 44,
   "speaker": "Dwayne",
   "text": "Not nothing. Less.",
   "agenda_item": "wellness",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 45,
   "speaker": "Valerie",
   "text": "The vote is on February twelfth.",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [
    "E038"
   ],
   "interrupted": false
  },
  {
   "index": 46,
   "speaker": "Dwayne",
   "text": "I'll put together the proposed budget and send it to the board by Monday.",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [
    "E039"
   ],
   "interrupted": false
  },
  {
   "index": 47,
   "speaker": "Phil",
   "text": "Can parents propose changes at the meeting?",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [
    "E040"
   ],
   "interrupted": false
  },
  {
   "index": 48,
   "speaker": "Valerie",
   "text": "Amendments are allowed, if they're seconded.",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 49,
   "speaker": "Phil",
   "text": "Then I'll be proposing one.",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [
    "E041"
   ],
   "interrupted": false
  },
  {
   "index": 50,
   "speaker": "Sienna",
   "text": "Will students be allowed to speak at the vote?",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [
    "E042"
   ],
   "interrupted": false
  },
  {
   "index": 51,
   "speaker": "Dwayne",
   "text": "Phil, if you're proposing an amendment, send it to me in writing first.",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 52,
   "speaker": "Phil",
   "text": "Fine. Who's chairing the vote, you or Valerie?",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [
    "E043",
    "E044"
   ],
   "interrupted": false
  },
  {
   "index": 53,
   "speaker": "Valerie",
   "text": "I am. And it'll be orderly.",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  },
  {
   "index": 54,
   "speaker": "Phil",
   "text": "We'll see.",
   "agenda_item": "vote",
   "direction": null,
   "event_ids": [],
   "interrupted": false
  }
 ],
