 "timeline": [
  {
   "turn_index": 0,
   "speaker": "Joel",
   "text": "Okay, everyone's on. Mika, do you want to start with the ceremony roles?",
   "start_s": 0.5,
   "end_s": 4.957
  },
  {
   "turn_index": 1,
   "speaker": "Mika",
   "text": "Yes. I want both of you to walk me down the aisle. Mom and Dad. Together.",
   "start_s": 6.113,
   "end_s": 11.931
  },
  {
   "turn_index": 2,
   "speaker": "Akiko",
   "text": "Together. Next to him.",
   "start_s": 13.079,
   "end_s": 14.579
  },
  {
   "turn_index": 3,
   "speaker": "Ernesto",
   "text": "I can manage that if your mother can.",
   "start_s": 14.836,
   "end_s": 18.036
  },
  {
   "turn_index": 4,
   "speaker": "Akiko",
   "text": "I can manage anything for one aisle.",
   "start_s": 18.321,
   "end_s": 20.946
  },
  {
   "turn_index": 5,
   "speaker": "Joel",
   "text": "That's a yes from both of you, then?",
   "start_s": 21.981,
   "end_s": 24.724
  },
  {
   "turn_index": 6,
   "speaker": "Ernesto",
   "text": "Yes.",
   "start_s": 25.66,
   "end_s": 26.06
  },
  {
   "turn_index": 7,
   "speaker": "Akiko",
   "text": "Yes. For Mika.",
   "start_s": 26.93,
   "end_s": 28.055
  },
  {
   "turn_index": 8,
   "speaker": "Mika",
   "text": "Thank you. Both of you. Then that's how we're doing it.",
   "start_s": 28.563,
   "end_s": 32.563
  },
  {
   "turn_index": 9,
   "speaker": "Joel",
   "text": "And speeches? Who's giving one?",
   "start_s": 33.369,
   "end_s": 35.083
  },
  {
   "turn_index": 10,
   "speaker": "Mika",
   "text": "Dad, and Owen's best man. And I asked Sandra to do a reading.",
   "start_s": 35.89,
   "end_s": 40.617
  },
  {
   "turn_index": 11,
   "speaker": "Akiko",
   "text": "You asked Sandra? Ernesto's wife?",
   "start_s": 41.398,
   "end_s": 43.273
  },
  {
   "turn_index": 12,
   "speaker": "Mika",
   "text": "She's been in my life for eight years, Mom.",
   "start_s": 43.631,
   "end_s": 46.904
  },
  {
   "turn_index": 13,
   "speaker": "Akiko",
   "text": "I gave birth to you. That's thirty-one years.",
   "start_s": 47.535,
   "end_s": 50.535
  },
  {
   "turn_index": 14,
   "speaker": "Joel",
   "text": "That reminds me of Aunt Rosie's wedding, the one with the bagpipes nobody asked for.",
   "start_s": 51.129,
   "end_s": 56.271
  },
  {
   "turn_index": 15,
   "speaker": "Mika",
   "text": "Joel, not now.",
   "start_s": 57.194,
   "end_s": 58.285
  },
  {
   "turn_index": 16,
   "speaker": "Ernesto",
   "text": "Akiko, Sandra will read and sit down. That's all.",
   "start_s": 59.48,
   "end_s": 63.08
  },
  {
   "turn_index": 17,
   "speaker": "Akiko",
   "text": "Then I'll do a reading too.",
   "start_s": 64.229,
   "end_s": 66.479
  },
  {
   "turn_index": 18,
   "speaker": "Mika",
   "text": "Okay. Mom reads, Sandra reads. Two readings.",
   "start_s": 67.223,
   "end_s": 69.769
  },
  {
   "turn_index": 19,
   "speaker": "Joel",
   "text": "Guest list. The cap is a hundred and ten.",
   "start_s": 70.414,
   "end_s": 73.5
  },
  {
   "turn_index": 20,
   "speaker": "Akiko",
   "text": "And we already have about a hundred yeses, so we're nearly there.",
   "start_s": 73.968,
   "end_s": 78.468
  },
  {
   "turn_index": 21,
   "speaker": "Ernesto",
   "text": "Then where do my side go?",
   "start_s": 78.704,
   "end_s": 81.104
  },
  {
   "turn_index": 22,
   "speaker": "Akiko",
   "text": "Your side is very large for someone who left.",
   "start_s": 81.331,
   "end_s": 84.706
  },
  {
   "turn_index": 23,
   "speaker": "Mika",
   "text": "Mom.",
   "start_s": 85.371,
   "end_s": 85.735
  },
  {
   "turn_index": 24,
   "speaker": "Joel",
   "text": "Can we look at the actual list before we fight about it?",
   "start_s": 86.253,
   "end_s": 90.368
  },
  {
   "turn_index": 25,
   "speaker": "Ernesto",
   "text": "Sandra's restaurant could do the rehearsal dinner, you know. She's offered.",
   "start_s": 90.948,
   "end_s": 95.348
  },
  {
   "turn_index": 26,
   "speaker": "Akiko",
   "text": "I'm sure the food is very authentic.",
   "start_s": 96.44,
   "end_s": 99.065
  },
  {
   "turn_index": 27,
   "speaker": "Ernesto",
   "text": "It's very good, actually. It was in the paper last month.",
   "start_s": 99.791,
   "end_s": 104.191
  },
  {
   "turn_index": 28,
   "speaker": "Joel",
   "text": "I have the RSVP sheet open. It's eighty-seven yeses, not a hundred.",
   "start_s": 104.952,
   "end_s": 109.066
  },
  {
   "turn_index": 29,
   "speaker": "Akiko",
   "text": "Eighty-seven. I was counting the maybes.",
   "start_s": 109.502,
   "end_s": 111.752
  },
  {
   "turn_index": 30,
   "speaker": "Mika",
   "text": "So twenty-three spots left, roughly.",
   "start_s": 111.976,
   "end_s": 113.794
  },
  {
   "turn_index": 31,
   "speaker": "Joel",
   "text": "How many does each side want to add?",
   "start_s": 114.319,
   "end_s": 117.062
  },
  {
   "turn_index": 32,
   "speaker": "Ernesto",
   "text": "Eight from my side. Cousins in Monterrey.",
   "start_s": 117.399,
   "end_s": 120.199
  },
  {
   "turn_index": 33,
   "speaker": "Akiko",
   "text": "Then eight from mine. That's fair.",
   "start_s": 120.909,
   "end_s": 123.159
  },
  {
   "turn_index": 34,
   "speaker": "Mika",
   "text": "Sixteen more is fine. Eight each, and that's the list.",
   "start_s": 124.358,
   "end_s": 127.994
  },
  {
   "turn_index": 35,
   "speaker": "Joel",
   "text": "I'll update the sheet tonight with both sets of eight.",
   "start_s": 128.868,
   "end_s": 132.297
  },
  {
   "turn_index": 36,
   "speaker": "Akiko",
   "text": "Is the rehearsal dinner at Sandra's restaurant, then?",
   "start_s": 132.679,
   "end_s": 135.679
  },
  {
   "turn_index": 37,
   "speaker": "Joel",
   "text": "Budget. Total is twenty-seven five.",
   "start_s": 136.773,
   "end_s": 138.487
  },
  {
   "turn_index": 38,
   "speaker": "Ernesto",
   "text": "I'm putting in ten thousand, like I said.",
   "start_s": 139.484,
   "end_s": 142.684
  },
  {
   "turn_index": 39,
   "speaker": "Mika",
   "text": "Dad. We agreed on eight. Each of you, eight.",
   "start_s": 143.618,
   "end_s": 146.891
  },
  {
   "turn_index": 40,
   "speaker": "Ernesto",
   "text": "Eight. Right. Eight. I'd said ten at first, I know.",
   "start_s": 147.998,
   "end_s": 151.998
  },
  {
   "turn_index": 41,
   "speaker": "Akiko",
   "text": "Eight from me as well. Already transferred.",
   "start_s": 152.961,
   "end_s": 155.586
  },
  {
   "turn_index": 42,
   "speaker": "Joel",
   "text": "So sixteen from you both, and Mika and Owen cover the rest.",
   "start_s": 156.576,
   "end_s": 160.69
  },
  {
   "turn_index": 43,
   "speaker": "Akiko",
   "text": "Has Owen's family said what they're putting in?",
   "start_s": 161.244,
   "end_s": 164.244
  },
  {
   "turn_index": 44,
   "speaker": "Mika",
   "text": "The big quotes are the DJ and the flowers.",
   "start_s": 165.425,
   "end_s": 168.698
  },
  {
   "turn_index": 45,
   "speaker": "Joel",
   "text": "The DJ is sixteen fifty. The flowers came in at twenty-two hundred.",
   "start_s": 169.86,
   "end_s": 173.974
  },
  {
   "turn_index": 46,
   "speaker": "Akiko",
   "text": "Twenty-two hundred for flowers is reasonable, I suppose.",
   "start_s": 174.335,
   "end_s": 177.335
  },
  {
   "turn_index": 47,
   "speaker": "Ernesto",
   "text": "Could we do fewer flowers and more food?",
   "start_s": 178.289,
   "end_s": 181.489
  },
  {
   "turn_index": 48,
   "speaker": "Mika",
   "text": "The flowers are already small. It's mostly greenery.",
   "start_s": 182.404,
   "end_s": 185.313
  },
  {
   "turn_index": 49,
   "speaker": "Joel",
   "text": "Somebody should probably ask the florist about a payment plan.",
   "start_s": 185.974,
   "end_s": 189.403
  },
  {
   "turn_index": 50,
   "speaker": "Mika",
   "text": "I'll call the florist on Friday about splitting the payment.",
   "start_s": 190.133,
   "end_s": 193.77
  },
  {
   "turn_index": 51,
   "speaker": "Akiko",
   "text": "When is the venue balance due?",
   "start_s": 194.46,
   "end_s": 196.71
  },
  {
   "turn_index": 52,
   "speaker": "Joel",
   "text": "August first.",
   "start_s": 197.835,
   "end_s": 198.521
  },
  {
   "turn_index": 53,
   "speaker": "Ernesto",
   "text": "August. That's soon.",
   "start_s": 199.222,
   "end_s": 200.422
  },
  {
   "turn_index": 54,
   "speaker": "Joel",
   "text": "Logistics. The ceremony is at four, right?",
   "start_s": 201.454,
   "end_s": 203.854
  },
  {
   "turn_index": 55,
   "speaker": "Mika",
   "text": "Four thirty. The church moved us because of a baptism.",
   "start_s": 204.408,
   "end_s": 208.044
  },
  {
   "turn_index": 56,
   "speaker": "Akiko",
   "text": "Four thirty. I'll tell the photographer.",
   "start_s": 209.127,
   "end_s": 211.377
  },
  {
   "turn_index": 57,
   "speaker": "Joel",
   "text": "The hotel block is fifteen rooms. Is that enough for the Monterrey cousins?",
   "start_s": 212.477,
   "end_s": 216.934
  },
  {
   "turn_index": 58,
   "speaker": "Ernesto",
   "text": "Fifteen is plenty. Most of them will share.",
   "start_s": 217.595,
   "end_s": 220.795
  },
  {
   "turn_index": 59,
   "speaker": "Joel",
   "text": "Sorry, I'm distracted, I have a job interview at nine tomorrow.",
   "start_s": 221.563,
   "end_s": 225.334
  },
  {
   "turn_index": 60,
   "speaker": "Mika",
   "text": "Joel! Where?",
   "start_s": 226.454,
   "end_s": 227.182
  },
  {
   "turn_index": 61,
   "speaker": "Akiko",
   "text": "The rehearsal dinner. How many people?",
   "start_s": 228.106,
   "end_s": 230.356
  },
  {
   "turn_index": 62,
   "speaker": "Mika",
   "text": "Twenty-four. Family and the wedding party.",
   "start_s": 231.043,
   "end_s": 233.224
  },
  {
   "turn_index": 63,
   "speaker": "Ernesto",
   "text": "Sandra's restaurant seats thirty in the back room.",
   "start_s": 233.646,
   "end_s": 236.846
  },
  {
   "turn_index": 64,
   "speaker": "Akiko",
   "text": "Fine. Sandra's restaurant. For the rehearsal dinner only.",
   "start_s": 237.371,
   "end_s": 240.371
  },
  {
   "turn_index": 65,
   "speaker": "Ernesto",
   "text": "Thank you, Akiko. Really.",
   "start_s": 241.271,
   "end_s": 242.871
  },
  {
   "turn_index": 66,
   "speaker": "Mika",
   "text": "Did anyone check the date's on the save-the-dates right? Owen's aunt thinks it's the nineteenth.",
   "start_s": 243.237,
   "end_s": 248.692
  },
  {
   "turn_index": 67,
   "speaker": "Joel",
   "text": "It's the eighteenth, October eighteenth. I'll text Owen's aunt myself.",
   "start_s": 249.8,
   "end_s": 253.229
  },
  {
   "turn_index": 68,
   "speaker": "Mika",
   "text": "Thank you, everyone. That went better than I thought.",
   "start_s": 253.697,
   "end_s": 256.97
  },
  {
   "turn_index": 69,
   "speaker": "Akiko",
   "text": "It did.",
   "start_s": 258.081,
   "end_s": 258.831
  }
 ]
}